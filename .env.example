# Finyl-DCP environment template — copy to backend/.env (bare metal) or .env (docker compose)

# --- Database -----------------------------------------------------------------
# Any PostgreSQL 14+ instance. With docker-compose this is overridden automatically.
DATABASE_URL=postgresql://finyl:finyl@localhost:5432/finyl_dcp
# AWS RDS example (see deploy/AWS_OPTION1.md). TLS is enforced entirely via the
# URL query string — psycopg2 honours ?sslmode=require with NO code change:
#   DATABASE_URL=postgresql://USER:PASSWORD@<rds-endpoint>.<REGION>.rds.amazonaws.com:5432/finyl_dcp?sslmode=require
# For a dedicated RDS database use DB_SCHEMA=public.
# Schema to use ("public" for a dedicated database, or a named schema on a shared DB)
DB_SCHEMA=public
# Table DDL is owned by migrations/*.sql. Leave false in production (setting true
# lets the app create tables on boot and causes silent schema drift). true only for
# a throwaway local/dev DB with no migrations applied.
AUTO_CREATE_TABLES=false

# --- Background scheduler (in-process auto-reconcile worker) -------------------
# APScheduler job that resolves stuck B2C payouts per payments-enabled tenant.
# Set SCHEDULER_ENABLED=false when running multiple replicas (run it in one only).
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=5
SCHEDULER_STUCK_MINUTES=10

# --- Auth ---------------------------------------------------------------------
# [SECRET] JWT signing secret. The app REFUSES TO BOOT on a weak/short value
# (< 32 chars or a known placeholder). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# HS256 is the default; JWT_EXPIRY_MINUTES is the access-token lifetime (720 = 12h).
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=720

# --- PII field encryption (encryption at rest) --------------------------------
# [SECRET][CRITICAL] FIELD_ENCRYPTION_KEY is the PRIMARY key used to encrypt PII
# (e.g. borrower national_id) and derive the blind-index. It MUST be carried over
# unchanged when migrating data between hosts — with a different key existing
# ciphertext CANNOT be decrypted. Blank -> a key is derived from JWT_SECRET
# (so changing JWT_SECRET would then break decryption). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# [SECRET] Optional additional Fernet key kept as a SECONDARY decryption key
# (MultiFernet) — used for no-downtime key rotation. Same format as above.
PII_ENCRYPTION_KEY=

# --- CORS / browser origins ---------------------------------------------------
# Comma-separated list of browser Origins allowed to call the API with credentials.
# Keep the default when the SPA is served same-origin (Docker/nginx) — no CORS is
# triggered. For a SPLIT deploy (e.g. a Netlify front-end), add that origin here:
#   ALLOWED_ORIGINS=https://finyl-dcp.abacusai.cloud,https://app.example.com
# Never a wildcard (invalid with credentials). Blank -> Abacus origin only.
ALLOWED_ORIGINS=https://finyl-dcp.abacusai.cloud

# --- AI Agent + Vision OCR (any OpenAI-compatible chat-completions endpoint) -----
LLM_BASE_URL=https://api.openai.com/v1
# [SECRET] API key for the LLM endpoint above.
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5.5-mini
# Optional dedicated vision model for ID OCR; falls back to LLM_MODEL when blank.
LLM_VISION_MODEL=

# --- Safaricom Daraja (M-Pesa) — LIVE client, credential-gated ------------------
# Leave the consumer key/secret blank to keep M-Pesa NOT CONFIGURED (endpoints
# return 422 instead of faking a disbursement). Fill them to go live/sandbox.
#
# DARAJA_ENVIRONMENT is the SINGLE switch between sandbox and production; it
# selects the Daraja base URL everywhere:
#   sandbox    -> https://sandbox.safaricom.co.ke   (default — safe)
#   production -> https://api.safaricom.co.ke
# Keep it "sandbox" until you have completed deploy/DARAJA_GO_LIVE.md. In
# production the app FAILS CLOSED: if any B2C credential below is missing it
# refuses payouts rather than simulating or falling back to sandbox.
DARAJA_ENVIRONMENT=sandbox             # sandbox | production
# [SECRET] Daraja consumer key/secret (from the Safaricom developer portal).
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=your-paybill-shortcode
# [SECRET] Lipa-na-M-Pesa passkey.
DARAJA_PASSKEY=your-lipa-na-mpesa-passkey
DARAJA_INITIATOR_NAME=finyl-api
# [SECRET] Encrypted initiator password used for B2C payouts.
DARAJA_SECURITY_CREDENTIAL=
# Public base URL of THIS backend — Daraja callback URLs are built from it.
# Set to your own domain when running independently (e.g. https://api.example.com).
DARAJA_CALLBACK_BASE_URL=https://your-host.example.com
# [SECRET] Unguessable path segment embedded in every Daraja callback URL we
# register (Safaricom sends no auth header on webhooks). Override per-environment.
MPESA_CALLBACK_TOKEN=change-me-to-a-random-token

# --- Daraja webhook hardening (multi-paybill production pilot) -----------------
# See deploy/DARAJA_GO_LIVE.md §7 for full details.
#
# Perimeter source-IP allowlist for /mpesa/{token}/* callbacks (defence-in-depth
# on top of nginx + the secret path token). Comma-separated CIDRs; default ships
# the known Safaricom production ranges. Leave blank to disable the check.
SAFARICOM_IP_ALLOWLIST=196.201.214.0/24,196.201.213.0/24,196.201.212.0/24,196.201.211.0/24,196.201.176.0/20
# off      = no check
# log      = warn on a non-allowlisted IP but still process (DEFAULT; safe for sandbox)
# enforce  = reject non-allowlisted IPs with HTTP 403 BEFORE processing (set at go-live)
SAFARICOM_IP_ENFORCE=log
# Durable ingestion / dead-letter-queue tuning. Every callback is persisted before
# processing; failures retry with exponential backoff then dead-letter + alert.
WEBHOOK_MAX_ATTEMPTS=5                  # attempts before an event is dead-lettered
WEBHOOK_RETRY_BASE_SECONDS=60          # backoff = base * 2**(attempts-1), capped at 1h
WEBHOOK_RAW_RETENTION_HOURS=168        # purge raw_payload of processed events after 7d
WEBHOOK_DEAD_ALERT_THRESHOLD=1         # alert once dead count >= this

# --- Uwazii bulk SMS — LIVE provider, credential-gated --------------------------
# Two ways to authenticate: (a) provide a static UWAZII_ACCESS_TOKEN, or
# (b) leave it blank and set UWAZII_USERNAME/UWAZII_PASSWORD for two-step auth.
# Blank credentials = NOT CONFIGURED (no SMS is sent).
UWAZII_BASE_URL=https://restapi.uwaziimobile.com/v1/send
UWAZII_AUTH_URL=https://restapi.uwaziimobile.com/v1/authorize
UWAZII_TOKEN_URL=https://restapi.uwaziimobile.com/v1/accesstoken
# [SECRET] Static access token (option a). Overrides the username/password flow.
UWAZII_ACCESS_TOKEN=
# [SECRET] Username/password for two-step auth (option b).
UWAZII_USERNAME=
UWAZII_PASSWORD=
UWAZII_SENDER_ID=your-sender-id
# [SECRET] Optional shared-secret token for the unauthenticated delivery-report
# (DLR) webhook. When set, the DLR callback must carry it (path /sms/dlr/{token}
# or X-DLR-Token header). Blank -> legacy open behaviour.
UWAZII_DLR_TOKEN=

# --- Legacy generic SMS gateway (optional fallback) ---------------------------
# Only used by the legacy generic gateway path; leave as placeholders when using
# Uwazii above.
SMS_API_URL=placeholder
# [SECRET]
SMS_API_KEY=placeholder

# --- Client document storage --------------------------------------------------
# Directory that holds uploaded client documents (created on first upload).
# Relative paths resolve against the backend/ folder.
STORAGE_DIR=storage
MAX_UPLOAD_MB=10

# --- "Process ID" OCR — hybrid Vision-LLM + Tesseract fallback ----------------
# vision_llm uses the LLM_* endpoint above to read the Kenyan National ID, with a
# local Tesseract fallback. Set OCR_PROVIDER=tesseract to force local-only.
# Tesseract needs the system packages: tesseract-ocr tesseract-ocr-eng poppler-utils
OCR_PROVIDER=vision_llm
# Absolute path to the tesseract binary — leave blank to use whatever is on PATH.
TESSERACT_CMD=
OCR_LANGUAGES=eng

# --- eKYC identity verification (Creditinfo IDM) — LIVE, credential-gated --------
# EKYC_MOCK=false uses the live provider; blank credentials = NOT CONFIGURED
# (the endpoint returns 422 rather than a fake pass). Set EKYC_MOCK=true only for
# an offline demo with a deterministic mock.
EKYC_MOCK=false
EKYC_BASE_URL=https://idmtest.creditinfo.co.ke
EKYC_USERNAME=
EKYC_PASSWORD=
EKYC_STRATEGY_ID=

# --- CRB (Credit Reference Bureau) — provider-abstracted, credential-gated -------
# Supported providers: metropol | transunion | creditinfo. Blank credentials =
# NOT CONFIGURED (a check returns status 'not_configured', never a fake score).
CRB_PROVIDER=metropol
CRB_BASE_URL=
# [SECRET] CRB provider credentials.
CRB_API_KEY=
CRB_USERNAME=
CRB_PASSWORD=

# --- eKYC credentials (secrets) -----------------------------------------------
# (EKYC_* config block is above; these two are the secret values.)
# [SECRET] EKYC_USERNAME / EKYC_PASSWORD are set in the eKYC block above.

# --- Off-site database backups (deploy/backup_db.sh) --------------------------
# On Abacus the S3 target is auto-discovered from VM metadata — leave these blank.
# On any other host, set BACKUP_S3_BUCKET to enable off-site upload of pg_dump
# backups; without it the backup still runs LOCALLY (no off-site copy).
# See deploy/DISASTER_RECOVERY.md → "Off-Abacus configuration".
BACKUP_S3_BUCKET=
# Optional key prefix inside the bucket (default: backups/finyl-dcp).
BACKUP_S3_PREFIX=
# AWS credentials for the upload come from the standard AWS chain. Prefer an
# instance/task role; otherwise set the standard AWS_* vars in the environment:
# [SECRET] AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (and AWS_DEFAULT_REGION).
