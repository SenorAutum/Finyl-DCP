# Finyl-DCP environment template — copy to backend/.env (bare metal) or .env (docker compose)

# --- Database -----------------------------------------------------------------
# Any PostgreSQL 14+ instance. With docker-compose this is overridden automatically.
DATABASE_URL=postgresql://finyl:finyl@localhost:5432/finyl_dcp
# Schema to use ("public" for a dedicated database, or a named schema on a shared DB)
DB_SCHEMA=public

# --- Auth ---------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# --- AI Agent (any OpenAI-compatible chat-completions endpoint) -----------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# --- Safaricom Daraja (M-Pesa) — mock service ships by default -------------------
# Fill these and swap the client in backend/app/services/mpesa.py to go live.
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_SHORTCODE=your-paybill-shortcode
DARAJA_PASSKEY=your-lipa-na-mpesa-passkey

# --- Bulk SMS provider (Africa's Talking / Onfon / etc.) --------------------------
# Fill these and swap the provider in backend/app/services/sms.py to go live.
SMS_API_URL=https://api.your-sms-provider.com/v1/send
SMS_API_KEY=your-sms-api-key
